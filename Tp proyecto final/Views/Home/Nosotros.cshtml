@{
    ViewData["Title"] = "Nosotros";
}
<section class="bg-dark text-white py-5">
    <div class="container text-center">
        <h1 class="display-3 fw-bold">
            Sobre FunkoShop
        </h1>
        <p class="lead mt-3">
            Tu lugar para encontrar las mejores figuras
            coleccionables de tus universos favoritos.
        </p>
    </div>
</section>
<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-12 col-lg-6">
            <img src="~/img/multimedia/star-wars/baby-yoda-1.webp" alt="Funko coleccionables" class="img-fluid rounded shadow-sm">
        </div>
        <div class="col-12 col-lg-6">
            <h2 class="display-5 fw-bold mb-4">
                ¿Quiénes somos?
            </h2>
            <p class="fs-5 text-secondary">
                En FunkoShop creemos que cada colección
                cuenta una historia.
            </p>
            <p>
                Nuestro objetivo es acercar a los fans
                figuras inspiradas en películas, series,
                anime, videojuegos y cultura pop.
            </p>
            <p>
                Desde Star Wars hasta Harry Potter o Pokémon,
                buscamos que cada fan encuentre algo especial
                para sumar a su colección.
            </p>
        </div>
    </div>
</section>
<section class="container my-5">
    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="card-body">
                    <h3 class="fw-bold mb-3">
                        Nuestra misión
                    </h3>
                    <p class="text-secondary">
                        Acercar productos coleccionables
                        de calidad a fanáticos de todos
                        los universos geek.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="card-body">
                    <h3 class="fw-bold mb-3">
                        Comunidad
                    </h3>
                    <p class="text-secondary">
                        Creemos en el coleccionismo como
                        una forma de compartir historias,
                        fandoms y experiencias.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="card-body">
                    <h3 class="fw-bold mb-3">
                        Catálogo
                    </h3>
                    <p class="text-secondary">
                        Contamos con productos inspirados
                        en sagas icónicas, anime,
                        videojuegos y cultura pop.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="bg-light py-5">
    <div class="container text-center">
        <h2 class="display-6 fw-bold mb-3">
            ¿Listo para empezar tu colección?
        </h2>
        <p class="fs-5 text-secondary mb-4">
            Explorá nuestro catálogo y encontrá
            tu próximo Funko favorito.
        </p>
        <a asp-controller="Home" asp-action="Tienda" class="btn btn-dark btn-lg px-4"> Ir a la tienda </a>
    </div>
</section>
